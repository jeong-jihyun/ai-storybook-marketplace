# apps/api 환경변수 (없으면 시드 데이터로 동작)
DATABASE_URL=postgres://storybook:storybook@localhost:5432/storybook
DATABASE_SSL=false
DATABASE_POOL_MAX=3
# 토큰 서명 키 (없으면 DATABASE_URL 로 만든다)
# JWT_SECRET=
# 테스트 결제 끄기 (정식 출시 때)
# PAYMENT_TEST_MODE=false
# 구글 플레이 결제 검증 (계정 생기면)
# GOOGLE_PLAY_PACKAGE_NAME=com.jeongjihyun.donghwasup
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={...서비스 계정 키 JSON...}
# 애플 결제 검증 (계정 생기면)
# APPLE_ISSUER_ID= / APPLE_KEY_ID= / APPLE_PRIVATE_KEY= / APPLE_BUNDLE_ID=com.jeongjihyun.donghwasup / APPLE_ENV=sandbox
PORT=4000
# (선택) 모바일 웹 빌드를 API 서버에서 같이 제공
# WEB_DIST=../mobile/dist

# apps/mobile (폰에서 PC의 API를 볼 때: PC의 내부 IP)
# EXPO_PUBLIC_API_URL=http://192.168.0.10:4000

# 관리자 콘텐츠 수정 (README '관리자 콘텐츠 수정' 참고)
ADMIN_EMAILS=
NARRATION_TOKEN=
