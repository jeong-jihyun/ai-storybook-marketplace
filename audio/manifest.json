{
 "version": 1,
 "voice": "ko-KR-SunHiNeural",
 "books": {
  "b0000001-5b00-4c00-8000-000000000001": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000001/page-01.mp3",
     "duration": 10.96,
     "hash": "2fce8bc103a0",
     "cues": [
      {
       "start": 0.45,
       "end": 7.19,
       "text": "보름달이 동그랗게 뜬 밤, 토끼 토리는 이불 속에서 눈만 깜빡깜빡했어요."
      },
      {
       "start": 7.14,
       "end": 10.31,
       "text": "오늘은 왜 이렇게 잠이 안 올까?"
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000001/page-02.mp3",
     "duration": 11.2,
     "hash": "1732e5f20707",
     "cues": [
      {
       "start": 0.45,
       "end": 5.17,
       "text": "그때 창밖에서 \"칙칙폭폭\" 작은 소리가 들렸어요."
      },
      {
       "start": 5.12,
       "end": 10.53,
       "text": "은빛으로 반짝이는 달빛 기차가 토리네 마당에 멈춰 섰지 뭐예요."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000001/page-03.mp3",
     "duration": 8.99,
     "hash": "59bebb8d864c",
     "cues": [
      {
       "start": 0.45,
       "end": 8.39,
       "text": "잠이 안 오는 친구, 별 마을로 출발합니다!\" 차장 부엉이가 모자를 살짝 들어 인사했어요."
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000001/page-04.mp3",
     "duration": 11.89,
     "hash": "743161cf196f",
     "cues": [
      {
       "start": 0.45,
       "end": 4.95,
       "text": "기차는 구름 다리를 건너 하늘 높이 올라갔어요."
      },
      {
       "start": 4.9,
       "end": 11.23,
       "text": "창밖으로 별들이 손을 흔들며 \"안녕, 토리!\" 하고 반겨 주었어요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000001/page-05.mp3",
     "duration": 10.12,
     "hash": "cad6e898525a",
     "cues": [
      {
       "start": 0.45,
       "end": 6.43,
       "text": "별 마을에서는 아기 별들이 하품을 하며 하나둘 불을 끄고 있었어요."
      },
      {
       "start": 6.38,
       "end": 9.45,
       "text": "별들도 밤에는 쉬는구나."
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000001/page-06.mp3",
     "duration": 10.26,
     "hash": "77cca2252429",
     "cues": [
      {
       "start": 0.45,
       "end": 5.03,
       "text": "토리는 아기 별 하나에게 자장가를 불러 주었어요."
      },
      {
       "start": 4.98,
       "end": 9.6,
       "text": "아기 별은 \"고마워\" 하고 말하며 포근하게 잠들었어요."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000001/page-07.mp3",
     "duration": 11.01,
     "hash": "a595840c9ffe",
     "cues": [
      {
       "start": 0.45,
       "end": 5.88,
       "text": "돌아오는 기차 안, 토리의 눈꺼풀이 점점 무거워졌어요."
      },
      {
       "start": 5.83,
       "end": 10.34,
       "text": "덜컹덜컹 흔들리는 기차가 꼭 요람 같았거든요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000001/page-08.mp3",
     "duration": 13.69,
     "hash": "0b6fa823f243",
     "cues": [
      {
       "start": 0.45,
       "end": 4.42,
       "text": "눈을 떠 보니 토리는 제 이불 속이었어요."
      },
      {
       "start": 4.37,
       "end": 8.3,
       "text": "창밖 달님이 빙그레 웃으며 속삭였어요."
      },
      {
       "start": 8.3,
       "end": 10.84,
       "text": "잘 자, 토리."
      },
      {
       "start": 10.84,
       "end": 13.04,
       "text": "내일 또 만나."
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000002": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000002/page-01.mp3",
     "duration": 10.12,
     "hash": "8b3f722fed69",
     "cues": [
      {
       "start": 0.45,
       "end": 5.35,
       "text": "하늘 마을에는 폭신폭신한 구름 우체부들이 살아요."
      },
      {
       "start": 5.3,
       "end": 9.47,
       "text": "그중 가장 작은 우체부가 바로 몽실이예요."
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000002/page-02.mp3",
     "duration": 10.79,
     "hash": "dbb103b7e28d",
     "cues": [
      {
       "start": 0.45,
       "end": 6.98,
       "text": "어느 날 아침, 몽실이는 커다란 편지 가방을 메고 첫 배달을 나섰어요."
      },
      {
       "start": 6.93,
       "end": 10.13,
       "text": "오늘은 혼자서도 잘할 수 있어!"
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000002/page-03.mp3",
     "duration": 11.85,
     "hash": "645cd1f86fda",
     "cues": [
      {
       "start": 0.45,
       "end": 2.61,
       "text": "그런데 휘이잉!"
      },
      {
       "start": 2.56,
       "end": 7.44,
       "text": "장난꾸러기 바람이 불어와 편지 한 장을 데려가 버렸어요."
      },
      {
       "start": 7.44,
       "end": 11.18,
       "text": "받는 사람은 \"언덕 위 작은 새\"였어요."
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000002/page-04.mp3",
     "duration": 11.13,
     "hash": "5302e0677ba5",
     "cues": [
      {
       "start": 0.45,
       "end": 6.35,
       "text": "몽실이는 편지를 찾아 무지개 언덕까지 둥실둥실 날아갔어요."
      },
      {
       "start": 6.3,
       "end": 10.47,
       "text": "길에서 만난 해님이 반짝 길을 비춰 주었어요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000002/page-05.mp3",
     "duration": 9.37,
     "hash": "04919bcff3f7",
     "cues": [
      {
       "start": 0.45,
       "end": 4.33,
       "text": "드디어 나뭇가지에 걸린 편지를 찾았어요!"
      },
      {
       "start": 4.28,
       "end": 8.71,
       "text": "하지만 비에 젖어 글씨가 조금 번져 있었어요."
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000002/page-06.mp3",
     "duration": 12.23,
     "hash": "c58ea85bb9f3",
     "cues": [
      {
       "start": 0.45,
       "end": 4.73,
       "text": "몽실이는 작은 새에게 솔직하게 말했어요."
      },
      {
       "start": 4.68,
       "end": 11.56,
       "text": "미안해, 편지가 조금 젖었어.\" 작은 새는 괜찮다며 편지를 꼭 안았어요."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000002/page-07.mp3",
     "duration": 9.9,
     "hash": "0f833cc77462",
     "cues": [
      {
       "start": 0.45,
       "end": 5.48,
       "text": "편지에는 \"보고 싶어, 내 친구야\"라고 쓰여 있었어요."
      },
      {
       "start": 5.43,
       "end": 9.24,
       "text": "작은 새의 눈이 별처럼 반짝였어요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000002/page-08.mp3",
     "duration": 10.6,
     "hash": "1a1e6c9ddfe2",
     "cues": [
      {
       "start": 0.45,
       "end": 3.73,
       "text": "그날 밤 몽실이는 생각했어요."
      },
      {
       "start": 3.68,
       "end": 9.93,
       "text": "마음을 전하는 일은 정말 멋진 일이야.' 내일도 몽실이는 하늘을 날아요."
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000003": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000003/page-01.mp3",
     "duration": 10.67,
     "hash": "5f9c5bb894c9",
     "cues": [
      {
       "start": 0.45,
       "end": 5.45,
       "text": "따뜻한 모래 속에서 \"톡!\" 하고 알껍데기가 깨졌어요."
      },
      {
       "start": 5.4,
       "end": 10.01,
       "text": "꼬마 거북 바다가 세상에 처음 고개를 내밀었어요."
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000003/page-02.mp3",
     "duration": 10.6,
     "hash": "18b7b08cf47d",
     "cues": [
      {
       "start": 0.45,
       "end": 4.03,
       "text": "저 멀리 반짝이는 바다가 보였어요."
      },
      {
       "start": 3.98,
       "end": 9.94,
       "text": "우와, 저기가 우리 집이래!\" 하지만 바다까지는 아주 멀어 보였어요."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000003/page-03.mp3",
     "duration": 8.8,
     "hash": "f4e21d8fa8f9",
     "cues": [
      {
       "start": 0.45,
       "end": 5.14,
       "text": "철썩철썩 큰 파도 소리에 바다는 몸을 움츠렸어요."
      },
      {
       "start": 5.09,
       "end": 8.14,
       "text": "너무 커. 나는 너무 작은데…"
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000003/page-04.mp3",
     "duration": 10.17,
     "hash": "398079c5da2c",
     "cues": [
      {
       "start": 0.45,
       "end": 4.6,
       "text": "그때 게 아저씨가 집게를 흔들며 말했어요."
      },
      {
       "start": 4.55,
       "end": 9.51,
       "text": "한 번에 다 가지 않아도 돼. 한 걸음씩 가면 된단다."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000003/page-05.mp3",
     "duration": 9.73,
     "hash": "1c623e5f191b",
     "cues": [
      {
       "start": 0.45,
       "end": 5.39,
       "text": "바다는 한 걸음, 또 한 걸음 모래를 밀며 나아갔어요."
      },
      {
       "start": 5.34,
       "end": 9.07,
       "text": "뒤를 돌아보니 벌써 이만큼이나 왔어요!"
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000003/page-06.mp3",
     "duration": 9.85,
     "hash": "4fb0b771dc87",
     "cues": [
      {
       "start": 0.45,
       "end": 4.08,
       "text": "드디어 발끝에 차가운 물이 닿았어요."
      },
      {
       "start": 4.03,
       "end": 9.2,
       "text": "파도가 다가와 \"어서 와\" 하고 바다를 살며시 감싸 주었어요."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000003/page-07.mp3",
     "duration": 9.88,
     "hash": "433eb890de75",
     "cues": [
      {
       "start": 0.45,
       "end": 5.26,
       "text": "바닷속은 알록달록 물고기와 산호로 가득했어요."
      },
      {
       "start": 5.21,
       "end": 9.21,
       "text": "바다는 힘차게 앞발을 저으며 헤엄쳤어요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000003/page-08.mp3",
     "duration": 7.26,
     "hash": "621ec3cd4e1e",
     "cues": [
      {
       "start": 0.45,
       "end": 6.66,
       "text": "무서웠지만 해냈어!\" 꼬마 거북 바다는 오늘 아주 큰 용기를 배웠답니다."
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000004": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000004/page-01.mp3",
     "duration": 9.83,
     "hash": "1ce5ad7c9d48",
     "cues": [
      {
       "start": 0.45,
       "end": 4.25,
       "text": "가을 숲에 도토리가 우수수 떨어졌어요."
      },
      {
       "start": 4.2,
       "end": 9.17,
       "text": "다람쥐 도도는 볼이 빵빵해지도록 도토리를 모았어요."
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000004/page-02.mp3",
     "duration": 8.22,
     "hash": "d40c1a62d44c",
     "cues": [
      {
       "start": 0.45,
       "end": 7.61,
       "text": "이만큼이면 겨울 내내 배부르겠지?\" 도도의 나무 구멍 창고는 도토리로 꽉 찼어요."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000004/page-03.mp3",
     "duration": 9.57,
     "hash": "573eff91484c",
     "cues": [
      {
       "start": 0.45,
       "end": 5.77,
       "text": "그런데 길에서 만난 아기 고슴도치가 배를 문지르며 말했어요."
      },
      {
       "start": 5.72,
       "end": 8.9,
       "text": "나는 아직 하나도 못 모았어."
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000004/page-04.mp3",
     "duration": 8.99,
     "hash": "5cf30c3da5c1",
     "cues": [
      {
       "start": 0.45,
       "end": 3.46,
       "text": "도도는 잠깐 고민했어요."
      },
      {
       "start": 3.41,
       "end": 8.33,
       "text": "그리고 가장 크고 동그란 도토리 세 개를 꺼내 주었어요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000004/page-05.mp3",
     "duration": 9.47,
     "hash": "78c396bdfdc6",
     "cues": [
      {
       "start": 0.45,
       "end": 4.72,
       "text": "그 모습을 본 숲속 친구들이 하나둘 모였어요."
      },
      {
       "start": 4.67,
       "end": 8.8,
       "text": "토끼는 당근을, 곰은 꿀을 들고 왔지요."
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000004/page-06.mp3",
     "duration": 8.44,
     "hash": "01cc248112bb",
     "cues": [
      {
       "start": 0.45,
       "end": 7.83,
       "text": "우리 다 같이 겨울 잔치를 열자!\" 친구들은 가진 것을 조금씩 모아 큰 식탁을 차렸어요."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000004/page-07.mp3",
     "duration": 9.28,
     "hash": "278add56b25f",
     "cues": [
      {
       "start": 0.45,
       "end": 5.39,
       "text": "나눠 먹는 도토리는 혼자 먹을 때보다 훨씬 달콤했어요."
      },
      {
       "start": 5.34,
       "end": 8.61,
       "text": "웃음소리가 숲 가득 퍼졌어요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000004/page-08.mp3",
     "duration": 8.85,
     "hash": "82b3fd0f99db",
     "cues": [
      {
       "start": 0.45,
       "end": 3.09,
       "text": "도도는 알게 되었어요."
      },
      {
       "start": 3.04,
       "end": 8.18,
       "text": "나누면 줄어드는 게 아니라, 기쁨이 더 커진다는 것을요."
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000005": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000005/page-01.mp3",
     "duration": 7.55,
     "hash": "b894a0a99ae9",
     "cues": [
      {
       "start": 0.45,
       "end": 6.95,
       "text": "이 닦기 싫어!\" 아기 곰 뭉치는 칫솔을 쏙 숨기고 이불 속으로 들어갔어요."
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000005/page-02.mp3",
     "duration": 10.55,
     "hash": "fc82688071e8",
     "cues": [
      {
       "start": 0.45,
       "end": 6.11,
       "text": "그날 밤 꿈속에서 뭉치는 하얗게 반짝이는 성문 앞에 서 있었어요."
      },
      {
       "start": 6.06,
       "end": 9.89,
       "text": "여기는 반짝반짝 이 닦기 왕국이래요."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000005/page-03.mp3",
     "duration": 10.72,
     "hash": "03674475a2a8",
     "cues": [
      {
       "start": 0.45,
       "end": 3.93,
       "text": "성문지기 칫솔 기사가 말했어요."
      },
      {
       "start": 3.88,
       "end": 8.11,
       "text": "충치 괴물들이 이 마을을 어지럽히고 있어요."
      },
      {
       "start": 8.11,
       "end": 10.06,
       "text": "도와줄래요?"
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000005/page-04.mp3",
     "duration": 9.09,
     "hash": "c5c58eff1986",
     "cues": [
      {
       "start": 0.45,
       "end": 8.48,
       "text": "뭉치는 칫솔 기사와 함께 위아래로 쓱싹쓱싹, 동글동글 원을 그리며 괴물들을 쫓아냈어요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000005/page-05.mp3",
     "duration": 9.4,
     "hash": "6669cef99a98",
     "cues": [
      {
       "start": 0.45,
       "end": 5.58,
       "text": "구석구석 어금니 뒤에 숨은 괴물도 빠짐없이 찾아냈어요."
      },
      {
       "start": 5.53,
       "end": 8.75,
       "text": "안쪽도 꼼꼼히 닦아야 해!"
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000005/page-06.mp3",
     "duration": 8.17,
     "hash": "a79c4efe3606",
     "cues": [
      {
       "start": 0.45,
       "end": 3.43,
       "text": "마지막으로 물을 오물오물 퉤!"
      },
      {
       "start": 3.38,
       "end": 7.51,
       "text": "하자 왕국 전체가 반짝반짝 빛났어요."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000005/page-07.mp3",
     "duration": 10.5,
     "hash": "7ecda8bc6ee0",
     "cues": [
      {
       "start": 0.45,
       "end": 6.39,
       "text": "고마워요, 뭉치 용사님!\" 왕국 사람들이 박수를 쳐 주었어요."
      },
      {
       "start": 6.34,
       "end": 9.83,
       "text": "뭉치의 어깨가 으쓱 올라갔어요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000005/page-08.mp3",
     "duration": 8.63,
     "hash": "ebc53ca2b54b",
     "cues": [
      {
       "start": 0.45,
       "end": 4.45,
       "text": "아침에 일어난 뭉치는 칫솔부터 찾았어요."
      },
      {
       "start": 4.4,
       "end": 7.97,
       "text": "오늘도 쓱싹쓱싹, 반짝반짝!"
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000006": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000006/page-01.mp3",
     "duration": 9.37,
     "hash": "b9a44bf91c7f",
     "cues": [
      {
       "start": 0.45,
       "end": 6.34,
       "text": "하얀 눈이 펑펑 내린 날, 아이들이 동그란 눈사람을 만들었어요."
      },
      {
       "start": 6.29,
       "end": 8.72,
       "text": "이름은 포포였어요."
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000006/page-02.mp3",
     "duration": 9.78,
     "hash": "4f89b981d149",
     "cues": [
      {
       "start": 0.45,
       "end": 5.66,
       "text": "포포는 매일 아이들과 눈싸움을 하며 즐겁게 지냈어요."
      },
      {
       "start": 5.61,
       "end": 9.13,
       "text": "빨간 목도리가 포포의 자랑이었지요."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000006/page-03.mp3",
     "duration": 10.26,
     "hash": "99257769c1a0",
     "cues": [
      {
       "start": 0.45,
       "end": 3.42,
       "text": "어느 날 참새가 말했어요."
      },
      {
       "start": 3.37,
       "end": 9.6,
       "text": "곧 봄이 와. 봄이 오면 눈은 다 녹는대.\" 포포는 덜컥 겁이 났어요."
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000006/page-04.mp3",
     "duration": 8.25,
     "hash": "0fca8c70ed81",
     "cues": [
      {
       "start": 0.45,
       "end": 7.64,
       "text": "나도 녹아 버리는 걸까?\" 포포는 해님이 뜨지 않기를 바라며 밤하늘에 소원을 빌었어요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000006/page-05.mp3",
     "duration": 9.21,
     "hash": "9dafadcaf691",
     "cues": [
      {
       "start": 0.45,
       "end": 4.8,
       "text": "하지만 해님은 날마다 조금씩 따뜻해졌어요."
      },
      {
       "start": 4.75,
       "end": 8.56,
       "text": "포포의 몸도 조금씩 작아졌어요."
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000006/page-06.mp3",
     "duration": 10.0,
     "hash": "1cee1dab2ccb",
     "cues": [
      {
       "start": 0.45,
       "end": 5.6,
       "text": "작아진 포포의 발밑에서 초록 새싹이 고개를 내밀었어요."
      },
      {
       "start": 5.55,
       "end": 9.34,
       "text": "포포야, 네 덕분에 목이 촉촉해."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000006/page-07.mp3",
     "duration": 9.52,
     "hash": "cba5cdfe11e5",
     "cues": [
      {
       "start": 0.45,
       "end": 2.98,
       "text": "포포는 깨달았어요."
      },
      {
       "start": 2.93,
       "end": 8.86,
       "text": "녹은 눈은 사라지는 게 아니라 꽃과 나무를 키우는 물이 된다는 것을요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000006/page-08.mp3",
     "duration": 9.73,
     "hash": "b687a2fbed26",
     "cues": [
      {
       "start": 0.45,
       "end": 4.87,
       "text": "봄이 온 언덕에는 빨간 꽃이 활짝 피었어요."
      },
      {
       "start": 4.82,
       "end": 9.07,
       "text": "꼭 포포의 빨간 목도리를 닮은 꽃이었어요."
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000007": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000007/page-01.mp3",
     "duration": 10.48,
     "hash": "667895abcb36",
     "cues": [
      {
       "start": 0.45,
       "end": 5.58,
       "text": "깊은 숲속 커다란 참나무에 아기 부엉이 부부가 살았어요."
      },
      {
       "start": 5.53,
       "end": 9.82,
       "text": "부부는 밤하늘 별 세기를 가장 좋아했어요."
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000007/page-02.mp3",
     "duration": 10.62,
     "hash": "e9338ffb2ba6",
     "cues": [
      {
       "start": 0.45,
       "end": 3.28,
       "text": "하나, 둘, 셋…"
      },
      {
       "start": 3.23,
       "end": 4.6,
       "text": "어?"
      },
      {
       "start": 4.6,
       "end": 9.96,
       "text": "어디까지 셌더라?\" 부부는 매일 밤 숫자를 잊어버렸어요."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000007/page-03.mp3",
     "duration": 8.51,
     "hash": "48ace5182233",
     "cues": [
      {
       "start": 0.45,
       "end": 3.81,
       "text": "엄마 부엉이가 다가와 말했어요."
      },
      {
       "start": 3.76,
       "end": 7.85,
       "text": "숨을 크게 쉬고, 천천히 세어 보렴."
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000007/page-04.mp3",
     "duration": 12.57,
     "hash": "4351de790dd4",
     "cues": [
      {
       "start": 0.45,
       "end": 3.74,
       "text": "부부는 숨을 후우 내쉬었어요."
      },
      {
       "start": 3.69,
       "end": 5.05,
       "text": "하나…"
      },
      {
       "start": 5.05,
       "end": 6.49,
       "text": "둘…"
      },
      {
       "start": 6.49,
       "end": 7.84,
       "text": "셋…"
      },
      {
       "start": 7.84,
       "end": 11.91,
       "text": "별 하나에 숫자 하나씩, 아주 천천히요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000007/page-05.mp3",
     "duration": 9.42,
     "hash": "741b07238548",
     "cues": [
      {
       "start": 0.45,
       "end": 1.68,
       "text": "넷…"
      },
      {
       "start": 1.63,
       "end": 3.03,
       "text": "다섯…"
      },
      {
       "start": 3.03,
       "end": 4.44,
       "text": "여섯…"
      },
      {
       "start": 4.44,
       "end": 8.76,
       "text": "별을 셀수록 바람 소리가 부드럽게 들렸어요."
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000007/page-06.mp3",
     "duration": 9.09,
     "hash": "0689acec7995",
     "cues": [
      {
       "start": 0.45,
       "end": 1.88,
       "text": "일곱…"
      },
      {
       "start": 1.83,
       "end": 3.24,
       "text": "여덟…"
      },
      {
       "start": 3.24,
       "end": 4.55,
       "text": "아홉…"
      },
      {
       "start": 4.55,
       "end": 8.42,
       "text": "부부의 눈이 스르르 감기기 시작했어요."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000007/page-07.mp3",
     "duration": 10.84,
     "hash": "62631ce8d407",
     "cues": [
      {
       "start": 0.45,
       "end": 1.69,
       "text": "열…"
      },
      {
       "start": 1.64,
       "end": 5.96,
       "text": "열 번째 별은 부부의 꿈속에서 반짝였어요."
      },
      {
       "start": 5.96,
       "end": 10.17,
       "text": "엄마 부엉이가 날개로 살포시 덮어 주었어요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000007/page-08.mp3",
     "duration": 10.55,
     "hash": "272137ba473a",
     "cues": [
      {
       "start": 0.45,
       "end": 4.3,
       "text": "오늘 밤 너도 부부처럼 별을 세어 볼래?"
      },
      {
       "start": 4.25,
       "end": 7.08,
       "text": "하나, 둘, 셋…"
      },
      {
       "start": 7.08,
       "end": 9.9,
       "text": "잘 자, 우리 아기."
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000008": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000008/page-01.mp3",
     "duration": 9.71,
     "hash": "201cd4600729",
     "cues": [
      {
       "start": 0.45,
       "end": 4.23,
       "text": "마을 끝에 오래된 정원이 있었어요."
      },
      {
       "start": 4.18,
       "end": 9.06,
       "text": "그런데 올해는 꽃이 잘 피지 않아 정원이 조용했어요."
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000008/page-02.mp3",
     "duration": 11.92,
     "hash": "2f2c8a29f3f6",
     "cues": [
      {
       "start": 0.45,
       "end": 3.4,
       "text": "꿀벌 윙윙이는 고민했어요."
      },
      {
       "start": 3.35,
       "end": 7.97,
       "text": "꽃들이 왜 기운이 없을까?\" 해님이 대답했어요."
      },
      {
       "start": 7.97,
       "end": 11.26,
       "text": "꽃가루를 나눠 줄 친구가 필요해."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000008/page-03.mp3",
     "duration": 7.55,
     "hash": "04045dc75824",
     "cues": [
      {
       "start": 0.45,
       "end": 6.94,
       "text": "윙윙이는 작은 날개를 힘차게 붕붕 흔들며 이 꽃 저 꽃을 날아다녔어요."
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000008/page-04.mp3",
     "duration": 8.32,
     "hash": "95b8104a78bd",
     "cues": [
      {
       "start": 0.45,
       "end": 7.71,
       "text": "노란 꽃가루를 다리에 묻혀 빨간 꽃에게, 빨간 꽃가루는 보라 꽃에게 전해 주었지요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000008/page-05.mp3",
     "duration": 7.98,
     "hash": "9566387d7028",
     "cues": [
      {
       "start": 0.45,
       "end": 7.37,
       "text": "너무 작은 나 혼자서 될까?\" 지친 윙윙이 옆으로 친구 꿀벌들이 하나둘 날아왔어요."
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000008/page-06.mp3",
     "duration": 8.65,
     "hash": "3f2bfef458c8",
     "cues": [
      {
       "start": 0.45,
       "end": 8.04,
       "text": "꿀벌들이 함께 날자 정원에 살랑살랑 바람이 일고, 꽃봉오리가 톡톡 터지기 시작했어요."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000008/page-07.mp3",
     "duration": 8.65,
     "hash": "173c4693da72",
     "cues": [
      {
       "start": 0.45,
       "end": 4.9,
       "text": "며칠 뒤 정원은 알록달록 꽃밭이 되었어요."
      },
      {
       "start": 4.85,
       "end": 8.0,
       "text": "나비와 새들도 놀러 왔어요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000008/page-08.mp3",
     "duration": 8.97,
     "hash": "78337a720b0d",
     "cues": [
      {
       "start": 0.45,
       "end": 4.19,
       "text": "윙윙이는 꽃잎 위에서 미소 지었어요."
      },
      {
       "start": 4.14,
       "end": 8.31,
       "text": "작은 날갯짓이 정원을 다시 살려 낸 거예요."
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000009": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000009/page-01.mp3",
     "duration": 10.98,
     "hash": "1b1105cb5b40",
     "cues": [
      {
       "start": 0.45,
       "end": 5.56,
       "text": "비가 그친 오후, 하늘에 커다란 무지개가 걸렸어요."
      },
      {
       "start": 5.51,
       "end": 10.32,
       "text": "여우 소녀 루루는 무지개 끝이 어디인지 궁금했어요."
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000009/page-02.mp3",
     "duration": 8.37,
     "hash": "6c56cb0c8ef4",
     "cues": [
      {
       "start": 0.45,
       "end": 7.75,
       "text": "무지개 끝에는 무엇이 있을까?\" 루루는 작은 가방을 메고 언덕 너머로 달려갔어요."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000009/page-03.mp3",
     "duration": 9.54,
     "hash": "f913e11f2096",
     "cues": [
      {
       "start": 0.45,
       "end": 5.74,
       "text": "처음 도착한 빨강 마을에서는 모두가 빠르게 뛰어다녔어요."
      },
      {
       "start": 5.69,
       "end": 8.87,
       "text": "루루도 신나게 함께 달렸어요."
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000009/page-04.mp3",
     "duration": 8.58,
     "hash": "e96af57ea744",
     "cues": [
      {
       "start": 0.45,
       "end": 7.98,
       "text": "노랑 마을 친구들은 노래를 좋아했고, 초록 마을 친구들은 조용히 식물을 가꾸었어요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000009/page-05.mp3",
     "duration": 9.93,
     "hash": "6b6ac550304e",
     "cues": [
      {
       "start": 0.45,
       "end": 3.77,
       "text": "파랑 마을에서 루루는 물었어요."
      },
      {
       "start": 3.72,
       "end": 9.28,
       "text": "왜 마을마다 이렇게 다를까?\" 거북 할아버지가 웃으며 말했어요."
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000009/page-06.mp3",
     "duration": 8.17,
     "hash": "cbcad465bfc2",
     "cues": [
      {
       "start": 0.45,
       "end": 4.73,
       "text": "색이 하나뿐이라면 무지개가 될 수 없단다."
      },
      {
       "start": 4.68,
       "end": 7.51,
       "text": "달라서 함께 빛나는 거야."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000009/page-07.mp3",
     "duration": 10.48,
     "hash": "9d44c92ec998",
     "cues": [
      {
       "start": 0.45,
       "end": 4.37,
       "text": "보라 마을을 지나자 무지개 끝에 닿았어요."
      },
      {
       "start": 4.32,
       "end": 9.82,
       "text": "그곳에는 일곱 마을 친구들이 모두 모여 손을 잡고 있었어요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000009/page-08.mp3",
     "duration": 10.93,
     "hash": "b4b9f6615207",
     "cues": [
      {
       "start": 0.45,
       "end": 3.21,
       "text": "루루도 손을 내밀었어요."
      },
      {
       "start": 3.16,
       "end": 6.97,
       "text": "그 순간 무지개가 한 뼘 더 길어졌어요."
      },
      {
       "start": 6.97,
       "end": 10.28,
       "text": "루루의 주황빛이 더해졌거든요."
      }
     ]
    }
   }
  },
  "b0000001-5b00-4c00-8000-000000000010": {
   "pages": {
    "1": {
     "file": "files/b0000001-5b00-4c00-8000-000000000010/page-01.mp3",
     "duration": 12.59,
     "hash": "43c29a871242",
     "cues": [
      {
       "start": 0.45,
       "end": 2.07,
       "text": "따르릉!"
      },
      {
       "start": 2.02,
       "end": 4.77,
       "text": "아침 알람이 울렸어요."
      },
      {
       "start": 4.77,
       "end": 9.13,
       "text": "곰돌이 토토는 오늘 아주 큰 결심을 했어요."
      },
      {
       "start": 9.13,
       "end": 11.93,
       "text": "오늘은 혼자서 해 볼 거야!"
      }
     ]
    },
    "2": {
     "file": "files/b0000001-5b00-4c00-8000-000000000010/page-02.mp3",
     "duration": 12.88,
     "hash": "a2359758f527",
     "cues": [
      {
       "start": 0.45,
       "end": 3.17,
       "text": "먼저 옷 입기에 도전!"
      },
      {
       "start": 3.12,
       "end": 6.12,
       "text": "머리를 쏙, 팔을 쏙쏙."
      },
      {
       "start": 6.12,
       "end": 8.96,
       "text": "앗, 앞뒤가 바뀌었네?"
      },
      {
       "start": 8.96,
       "end": 12.21,
       "text": "토토는 다시 천천히 입었어요."
      }
     ]
    },
    "3": {
     "file": "files/b0000001-5b00-4c00-8000-000000000010/page-03.mp3",
     "duration": 10.67,
     "hash": "9dfa8f2eb3e8",
     "cues": [
      {
       "start": 0.45,
       "end": 3.01,
       "text": "다음은 양말 신기."
      },
      {
       "start": 2.96,
       "end": 6.38,
       "text": "발가락을 쏙 넣고 쭈욱 당겼어요."
      },
      {
       "start": 6.38,
       "end": 10.01,
       "text": "짝짝이 양말이지만 그래도 괜찮아요."
      }
     ]
    },
    "4": {
     "file": "files/b0000001-5b00-4c00-8000-000000000010/page-04.mp3",
     "duration": 8.82,
     "hash": "99d29ff12b52",
     "cues": [
      {
       "start": 0.45,
       "end": 5.06,
       "text": "신발은 오른쪽, 왼쪽을 잘 보고 신었어요."
      },
      {
       "start": 5.01,
       "end": 8.16,
       "text": "찍찍이도 꾹 눌러 붙였지요."
      }
     ]
    },
    "5": {
     "file": "files/b0000001-5b00-4c00-8000-000000000010/page-05.mp3",
     "duration": 11.27,
     "hash": "fec34ba4749a",
     "cues": [
      {
       "start": 0.45,
       "end": 6.11,
       "text": "가방에는 물병, 손수건, 그림책을 하나씩 넣었어요."
      },
      {
       "start": 6.06,
       "end": 10.61,
       "text": "빠진 거 없나?\" 토토는 손가락으로 세어 보았어요."
      }
     ]
    },
    "6": {
     "file": "files/b0000001-5b00-4c00-8000-000000000010/page-06.mp3",
     "duration": 9.97,
     "hash": "061a39d67a37",
     "cues": [
      {
       "start": 0.45,
       "end": 3.67,
       "text": "엄마가 깜짝 놀라며 말했어요."
      },
      {
       "start": 3.62,
       "end": 9.3,
       "text": "우와, 토토가 혼자서 다 했네!\" 토토는 볼이 발그레해졌어요."
      }
     ]
    },
    "7": {
     "file": "files/b0000001-5b00-4c00-8000-000000000010/page-07.mp3",
     "duration": 10.36,
     "hash": "9f31176f466c",
     "cues": [
      {
       "start": 0.45,
       "end": 5.81,
       "text": "유치원 가는 길, 토토의 발걸음은 깡충깡충 가벼웠어요."
      },
      {
       "start": 5.76,
       "end": 9.7,
       "text": "스스로 해낸 아침은 참 상쾌했거든요."
      }
     ]
    },
    "8": {
     "file": "files/b0000001-5b00-4c00-8000-000000000010/page-08.mp3",
     "duration": 8.17,
     "hash": "03865af9fcb7",
     "cues": [
      {
       "start": 0.45,
       "end": 7.57,
       "text": "내일은 단추 잠그기에 도전해야지!\" 혼자서도 척척 곰돌이 토토의 도전은 계속돼요."
      }
     ]
    }
   }
  }
 }
}