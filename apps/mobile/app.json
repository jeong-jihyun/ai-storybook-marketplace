{
  "expo": {
    "name": "동화숲",
    "slug": "ai-storybook-marketplace",
    "version": "0.3.0",
    "scheme": "donghwasup",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jeongjihyun.donghwasup"
    },
    "android": {
      "package": "com.jeongjihyun.donghwasup",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1DE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "동화숲 - AI 동화책방",
      "shortName": "동화숲",
      "lang": "ko",
      "themeColor": "#FFF8EE",
      "backgroundColor": "#FFF8EE"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EE"
        }
      ],
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "관리자가 동화 그림을 바꾸려고 사진을 골라요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": ""
    }
  }
}
